# Server Configuration
PORT=5001
NODE_ENV=production

# Email Configuration (Gmail example)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
NOTIFY_EMAIL=your-alert-email@gmail.com

# Bot Configuration
BOT_ENABLED=true
DAILY_TRADE_LIMIT=1
MAX_DAILY_LOSSES=1
BOT_START_HOUR=0
BOT_END_HOUR=23

# Trading Configuration
BTC_QUANTITY=0.01
RISK_PERCENTAGE=5
PROFIT_MULTIPLIER=1.5
TRADING_MIN_BTC_QTY=0.01
TRADING_MAX_BTC_QTY=0.04
MIN_CONFLUENCE_SCORE=4
ADX_THRESHOLD=18
ATR_STOP_MULTIPLIER=0.05
MAX_ATR_PERCENT_OF_PRICE=0.08
PARTIAL_TP_RR=100
FINAL_TP_RR=100
MIN_REWARD_TO_RISK=1.5
BREAKEVEN_TRIGGER_RR=1
TRAILING_START_RR=1
TRAILING_STOP_ATR_MULTIPLIER=2
MAX_SL_PERCENT_OF_PRICE=0.02
ALLOW_LONG_TRADES=true
ALLOW_SHORT_TRADES=true

# Backtest Realism
BACKTEST_FEE_RATE=0.001
BACKTEST_SLIPPAGE_RATE=0.0005
BACKTEST_SPREAD_RATE=0.0002

# Database
DATABASE_URL=./trading.db

# API Configuration - Set this for Railway deployment
# For Railway: https://your-project.railway.app
# For local development: http://localhost:5001/api
VITE_API_URL=/api

# Telegram (optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Deployment - Railway/Render
RENDER_EXTERNAL_URL=https://your-railway-domain.railway.app
DEPLOY_URL=https://your-domain.com
ALLOW_REMOTE_ACCESS=true

# Timezone
TIMEZONE=Asia/Kolkata

# Logging
LOG_LEVEL=info
SEND_EMAIL_ON_TRADE=true
SEND_DAILY_SUMMARY=true
SEND_ERROR_ALERTS=true
